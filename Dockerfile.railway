FROM node:22.23.4-slim

WORKDIR /app

# Match the npm version used by the successful GitHub Actions install.
RUN npm install --global npm@10.9.9

COPY package.json ./
RUN npm install --include=dev --no-audit --no-fund

COPY . .

RUN npm run build:railway

ENV NODE_ENV=production
ENV HOST=0.0.0.0
EXPOSE 8080

CMD ["npm", "run", "start:railway-api"]

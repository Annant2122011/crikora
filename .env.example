NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# Refresh poll. Keep source request pacing within the written Cricbuzz approval.
POLL_INTERVAL_MS=180000
SOURCE_MODE=demo
CRICKET_SOURCE_ENABLED=false

# Neon pooled connection string. Never commit a real value.
DATABASE_URL=

# Conservative initial settings. Replace with the exact numerical limits in the Cricbuzz approval.
CRICBUZZ_MIN_REQUEST_INTERVAL_MS=5000
CRICBUZZ_MAX_MATCHES_PER_POLL=2
CRICBUZZ_MAX_PROFILES_PER_POLL=2
CRICBUZZ_MAX_TEAMS_PER_POLL=2
CRICBUZZ_MAX_SERIES_PER_POLL=1
CRICBUZZ_MAX_VENUES_PER_POLL=1
CRICBUZZ_TIMEOUT_MS=15000
CRICBUZZ_MAX_RESPONSE_BYTES=8000000
CRICBUZZ_USER_AGENT=Crikora/0.1 (+https://github.com/Annant2122011/crikora; authorized data access)

# Comma-separated exact origins, e.g. chrome-extension://<extension-id>,https://crikora.example
CORS_ORIGINS=

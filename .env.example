NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# Crawler cycle cadence: 10, 15, 20 or 30 seconds. Default: fastest (10).
POLL_INTERVAL_SECONDS=10

# Enable only for the Cricbuzz collection workflow covered by the written approval.
CRIKORA_COLLECTION_ENABLED=false

# Cricbuzz match-detail collection cutoff (YYYY-MM-DD, Asia/Kolkata date).
# Earlier ball-by-ball data is supplied by the separate Cricsheet import.
CRIKORA_MATCH_DETAILS_FROM=2026-11-04

# Neon pooled connection string. Never commit a real value.
DATABASE_URL=

# Private Neon Object Storage for permanent compressed source-page captures.
# Obtain branch-scoped storage:read + storage:write credentials in Neon.
# These five values belong only in the Crikora core API server environment (Vercel root API or Railway crikora-api service).
# Never add them to the website or browser-extension build.
# AWS_ACCESS_KEY_ID is the Neon Object Storage credential's token_id, NOT a Neon API token.
# AWS_SECRET_ACCESS_KEY is that same credential's s3_secret_access_key.
# Keep the real values in a local .env or the host's encrypted environment-variable store; never commit them.
AWS_ENDPOINT_URL_S3=https://br-cold-bird-bdw51znf.storage.c-8.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CRIKORA_ARCHIVE_BUCKET=crikora-raw-archive

# Request pacing is independent of the refresh cycle. Set only when required by the source agreement.
CRICBUZZ_MIN_REQUEST_INTERVAL_MS=1000
CRICBUZZ_MAX_MATCHES_PER_POLL=2
CRICBUZZ_MAX_PROFILES_PER_POLL=2
CRICBUZZ_MAX_TEAMS_PER_POLL=2
CRICBUZZ_MAX_SERIES_PER_POLL=1
CRICBUZZ_MAX_VENUES_PER_POLL=1
CRICBUZZ_MAX_CONTENT_PAGES_PER_POLL=2

# Durable initial sitemap crawl. Each serverless step fetches 1-3 pages sequentially.
CRIKORA_CRAWL_BATCH_SIZE=1
CRIKORA_CRAWL_MAX_ATTEMPTS=4
CRICBUZZ_TIMEOUT_MS=15000
CRICBUZZ_MAX_RESPONSE_BYTES=8000000
CRICBUZZ_USER_AGENT=Crikora/0.1 (+https://github.com/Annant2122011/crikora)

# Vercel server-only secrets. Set these in the Vercel project, never in the extension.
CRIKORA_ADMIN_SECRET=
CRIKORA_REFRESH_SECRET=

# Comma-separated browser origins allowed to call the API (leave empty to disable CORS).
CORS_ORIGINS=

# Standalone persistent worker (optional, for Command Prompt or a self-hosted machine).
CRIKORA_API_BASE_URL=https://crikora.vercel.app/api
CRIKORA_WORKER_LEASE_SECONDS=180
CRIKORA_WORKER_IDLE_POLL_SECONDS=10

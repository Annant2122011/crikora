{
  "name": "crikora",
  "version": "0.1.0",
  "private": true,
  "description": "Crikora cricket data ingestion and highlights API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
    "test": "vitest run --exclude \"dist/**\" --exclude \"dist-railway/**\"",
    "test:watch": "vitest --exclude \"dist/**\" --exclude \"dist-railway/**\"",
    "worker:local": "tsx src/ingestion/worker-cli.ts",
    "archive:verify-storage": "tsx src/storage/archive-storage-verification-cli.ts",
    "sitemap:audit": "tsx src/ingestion/sitemap-audit-cli.ts",
    "build:railway": "tsc -p tsconfig.railway.json",
    "start:railway-api": "node dist-railway/src/railway-api.js",
    "start:railway-worker": "node dist-railway/src/ingestion/worker-cli.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@vercel/analytics": "^2.0.1",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  }
}
